+//! 표 셀의 행 색인 (성능 #2063 후속).
+//!
+//! 표 레이아웃·조판의 많은 행 단위 판정이 `table.cells.iter().filter(|c| c.row == row)`
+//! 처럼 **행마다 전체 셀을 다시 훑는다**. 행 루프·페이지 루프 안에서 불리면
+//! O(행×셀)(5,277행×52,694셀 표에서 수억 회)로 폭증한다.
+//!
+//! 이 색인은 셀 배열을 한 번만 훑어 행별 셀 인덱스를 **원래 셀 순서 그대로** 모은다.
+//! 따라서 `filter(row == r)` 를 이 색인으로 바꿔도 순회 순서·결과가 바이트 단위로 같다.
+//! `LayoutEngine` 의 다른 포인터 키 캐시(`cell_units_cache` 등)와 같은 조판 경계
+//! (`clear_layout_caches`)에서 비우며, 키에 셀 배열 포인터·길이·행 수를 함께 넣어
+//! 경계 밖의 구조 편집(행 추가/삭제·병합)도 자동으로 놓치지 않게 한다.
+
+use std::sync::Arc;
+
+use super::LayoutEngine;
+use crate::model::table::{Cell, Table};
+
+/// 행별 셀 인덱스 색인.
+#[derive(Debug, Default)]
+pub(crate) struct TableRowIndex {
+    /// `starts[r]` = `cell.row == r` 인 셀 인덱스(원래 순서).
+    starts: Vec<Vec<u32>>,
+    /// `covers[r]` = `cell.row <= r < cell.row + cell.row_span` 인 셀 인덱스(원래 순서).
+    /// 손상 문서의 거대 row_span 으로 메모리가 폭증하면 만들지 않는다(None → 선형 폴백).
+    covers: Option<Vec<Vec<u32>>>,
+    /// `Table::rowspan_declared_overflow_shrink()` 결과(지연 계산). 셀 높이에 의존하지만
+    /// `cell_units_cache` 도 같은 경계 안에서 셀 높이 불변을 전제하므로 같은 수명을 쓴다.
+    rowspan_shrink: std::sync::OnceLock<Vec<crate::model::HwpUnit>>,
+}
+
+/// 색인 캐시 키: (표 포인터, 셀 배열 포인터, 셀 수, 행 수).
+pub(crate) type TableRowIndexKey = (usize, usize, usize, u16);
+
+impl TableRowIndex {
+    fn build(table: &Table) -> Self {
+        let max_start = table
+            .cells
+            .iter()
+            .map(|cell| cell.row as usize + 1)
+            .max()
+            .unwrap_or(0);
+        let rows = max_start.max(table.row_count as usize);
+        let mut starts: Vec<Vec<u32>> = vec![Vec::new(); max_start];
+        let mut cover_entries = 0usize;
+        for (idx, cell) in table.cells.iter().enumerate() {
+            starts[cell.row as usize].push(idx as u32);
+            let end = (cell.row as usize + cell.row_span as usize).min(rows);
+            cover_entries += end.saturating_sub(cell.row as usize);
+        }
+        // 정상 표는 셀당 row_span 합이 셀 수의 몇 배를 넘지 않는다.
+        let cover_budget = table.cells.len().saturating_mul(8).max(1 << 16);
+        let covers = (cover_entries <= cover_budget).then(|| {
+            let mut covers: Vec<Vec<u32>> = vec![Vec::new(); rows];
+            for (idx, cell) in table.cells.iter().enumerate() {
+                let start = cell.row as usize;
+                let end = (start + cell.row_span as usize).min(rows);
+                for bucket in covers.iter_mut().take(end).skip(start) {
+                    bucket.push(idx as u32);
+                }
+            }
+            covers
+        });
+        Self {
+            starts,
+            covers,
+            rowspan_shrink: std::sync::OnceLock::new(),
+        }
+    }
+
+    /// `cell.row == row` 인 셀 인덱스(원래 순서). 범위 밖이면 빈 슬라이스.
+    pub(crate) fn starting(&self, row: usize) -> &[u32] {
+        self.starts.get(row).map(Vec::as_slice).unwrap_or(&[])
+    }
+
+    /// `cell.row <= row < cell.row + cell.row_span` 인 셀 인덱스(원래 순서).
+    /// 색인이 없거나 범위 밖이면 `None` — 호출부가 선형 스캔으로 폴백한다.
+    pub(crate) fn covering(&self, row: usize) -> Option<&[u32]> {
+        self.covers.as_ref()?.get(row).map(Vec::as_slice)
+    }
+}
+
+impl LayoutEngine {
+    /// `table.rowspan_declared_overflow_shrink()` 의 캐시 판. 행마다 호출되는 컷 높이
+    /// 계산이 표 전체를 매번 다시 훑지 않게 한다.
+    pub(crate) fn rowspan_declared_overflow_shrink_at(
+        &self,
+        table: &Table,
+        row: usize,
+    ) -> crate::model::HwpUnit {
+        let index = self.table_row_index(table);
+        index
+            .rowspan_shrink
+            .get_or_init(|| table.rowspan_declared_overflow_shrink())
+            .get(row)
+            .copied()
+            .unwrap_or(0)
+    }
+
+    /// `LayoutEngine::row_cut_cell_order` 의 색인 판 — 같은 순서를 돌려준다.
+    pub(crate) fn row_cut_cell_order_indexed(&self, table: &Table, row: usize) -> Vec<usize> {
+        let index = self.table_row_index(table);
+        let mut cells: Vec<(u16, usize)> = index
+            .starting(row)
+            .iter()
+            .map(|&idx| idx as usize)
+            .filter(|&idx| table.cells[idx].row_span == 1)
+            .map(|idx| (table.cells[idx].col, idx))
+            .collect();
+        cells.sort_by_key(|(col, _)| *col);
+        cells.into_iter().map(|(_, idx)| idx).collect()
+    }
+
+    /// 표의 행 색인(캐시). 같은 표·같은 셀 배열이면 한 번만 만든다.
+    pub(crate) fn table_row_index(&self, table: &Table) -> Arc<TableRowIndex> {
+        let key: TableRowIndexKey = (
+            table as *const Table as usize,
+            table.cells.as_ptr() as usize,
+            table.cells.len(),
+            table.row_count,
+        );
+        if let Some(cached) = self.table_row_index_cache.borrow().get(&key) {
+            return Arc::clone(cached);
+        }
+        let index = Arc::new(TableRowIndex::build(table));
+        self.table_row_index_cache
+            .borrow_mut()
+            .insert(key, Arc::clone(&index));
+        index
+    }
+
+    /// `table.cells.iter().filter(|c| c.row as usize == row)` 와 같은 순서의 셀들.
+    pub(crate) fn cells_starting_in_row<'a>(
+        &self,
+        table: &'a Table,
+        row: usize,
+    ) -> impl Iterator<Item = &'a Cell> + 'a {
+        let index = self.table_row_index(table);
+        let ids: Vec<u32> = index.starting(row).to_vec();
+        ids.into_iter().map(move |idx| &table.cells[idx as usize])
+    }
+
+    /// `table.cells.iter().filter(|c| c.row <= row && row < c.row + c.row_span)` 와 같은
+    /// 순서의 셀들.
+    pub(crate) fn cells_covering_row<'a>(
+        &self,
+        table: &'a Table,
+        row: usize,
+    ) -> Box<dyn Iterator<Item = &'a Cell> + 'a> {
+        let index = self.table_row_index(table);
+        match index.covering(row) {
+            Some(ids) => {
+                let ids = ids.to_vec();
+                Box::new(ids.into_iter().map(move |idx| &table.cells[idx as usize]))
+            }
+            None => Box::new(table.cells.iter().filter(move |cell| {
+                cell.row as usize <= row && row < cell.row as usize + cell.row_span as usize
+            })),
+        }
+    }
+}
